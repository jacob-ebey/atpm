{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "key": "any",
      "type": "record",
      "record": {
        "type": "object",
        "required": ["createdAt", "allowStage", "allowPublish"],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "allowStage": {
            "type": "boolean"
          },
          "allowPublish": {
            "type": "boolean"
          },
          "github": {
            "type": "ref",
            "ref": "#github",
            "description": "Trust config for GitHub Actions. Other providers (e.g. gitlab, circleci) will add their own config refs alongside this one."
          }
        }
      }
    },
    "github": {
      "type": "object",
      "required": ["username", "repository", "workflow"],
      "properties": {
        "username": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        }
      }
    }
  },
  "id": "dev.atpm.alpha.trustPublisher",
  "lexicon": 1
}
